import numpy as np
from gensim.downloader import load
from sklearn.neighbors import NearestNeighbors

# 1. Load pretrained word embeddings
model = load("glove-wiki-gigaword-50")

docs = [
    "machine learning", "deep learning",
    "artificial intelligence", "football game",
    "neural networks", "computer science"
]

# 2. Create document embeddings
def embed(text):
    words = [model[w] for w in text.lower().split() if w in model]
    return np.mean(words, axis=0) if words else np.zeros(50)

