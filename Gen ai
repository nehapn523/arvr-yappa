    batch_size=1,
    model=model,
    diffusion=diffusion,
    guidance_scale=15.0,
    model_kwargs={"texts": [prompt]},
    progress=True,
    clip_denoised=True,
    use_fp16=(device.type == "cuda"),
    use_karras=True,
    karras_steps=16,
    sigma_min=1e-3,
    sigma_max=160,
