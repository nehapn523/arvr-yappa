@tool
def debugger(code: str) -> str:
    """Check Python code for syntax errors."""
    try:
        compile(code, "<string>", "exec")
        return "No syntax errors found."
    except SyntaxError as e:
        return f"Syntax error: {e.msg}, line {e.lineno}"

