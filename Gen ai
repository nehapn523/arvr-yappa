from datasets import load_dataset
from sentence_transformers import SentenceTransformer
from transformers import pipeline
import numpy as np, re

# 1. Load dataset
data = load_dataset("hotpot_qa", "distractor",
                    split="validation[:20]")

# 2. Load embedding and QA models
embedder = SentenceTransformer("all-MiniLM-L6-v2")
qa = pipeline("question-answering",
              model="distilbert/distilbert-base-cased-distilled-squad")

# 3. Evaluation functions
def normalize(s):
    return re.sub(r"[^a-z0-9 ]", "", s.lower()).split()

def evaluate(pred, ref):
    p, r = normalize(pred), normalize(ref)
    common = sum((__import__("collections").Counter(p) &
                  __import__("collections").Counter(r)).values())
    f1 = 2 * common / (len(p) + len(r)) if p or r else 1
    return int(p == r), f1

# 4. Compare single-hop and multi-hop RAG
results = {"Single-hop": [], "Multi-hop": []}

for item in data:
    q, answer = item["question"], item["answer"]
    docs = [" ".join(s) for s in item["context"]["sentences"]]
    vectors = embedder.encode(docs, normalize_embeddings=True)

    # Single-hop: retrieve the best passage
    qvec = embedder.encode([q], normalize_embeddings=True)[0]
    first = int(np.argmax(vectors @ qvec))
    selected = [first]

    # Multi-hop: use first passage to refine retrieval
    expanded = q + " " + docs[first]
    qvec2 = embedder.encode([expanded],
                            normalize_embeddings=True)[0]
    order = np.argsort(vectors @ qvec2)[::-1]
    selected += [int(i) for i in order if i not in selected][:1]

    for name, ids in [("Single-hop", [first]),
                      ("Multi-hop", selected)]:
        context = " ".join(docs[i] for i in ids)
        pred = qa(question=q, context=context)["answer"]
        results[name].append(evaluate(pred, answer))

# 5. Print EM and F1
for name, scores in results.items():
    print(name,
          "EM:", round(np.mean([s[0] for s in scores]), 3),
          "F1:", round(np.mean([s[1] for s in scores]), 3))

