from datasets import load_dataset
from transformers import pipeline
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import classification_report, accuracy_score

# 1. Load dataset
data = load_dataset("ag_news")
train, test = data["train"], data["test"]

labels = ["World", "Sports", "Business", "Sci/Tech"]
X = [train[i]["text"] for i in range(100)]
y = [train[i]["label"] for i in range(100)]
texts = [test[i]["text"] for i in range(20)]
true = [test[i]["label"] for i in range(20)]

# 2. Zero-shot classification
zs = pipeline("zero-shot-classification",
              model="valhalla/distilbart-mnli-12-1")
zero = [labels.index(zs(t, labels)["labels"][0]) for t in texts]

# 3. Few-shot classification using KNN
vec = TfidfVectorizer()
Xv = vec.fit_transform(X)
knn = KNeighborsClassifier(n_neighbors=3).fit(Xv, y)
few = knn.predict(vec.transform(texts))

# 4. Rule-based classification
def rule(text):
    t = text.lower()
    if any(w in t for w in ["football", "match", "player", "team"]):
        return 1
    if any(w in t for w in ["stock", "market", "company", "profit"]):
        return 2
    if any(w in t for w in ["computer", "software", "technology", "internet"]):
        return 3
    return 0

rules = [rule(t) for t in texts]

# 5. Evaluate all methods
for name, pred in [("Zero-shot", zero),
                   ("Few-shot", few),
                   ("Rule-based", rules)]:
    print("\n", name)
    print("Accuracy:", round(accuracy_score(true, pred), 3))
    print(classification_report(
        true, pred, labels=[0, 1, 2, 3],
        target_names=labels, zero_division=0
    ))

# 6. Display a structured prediction
print("\nStructured Output:")
print({"text": texts[0], "category": labels[zero[0]]})

