from transformers import pipeline
from datasets import load_dataset
from rouge_score import rouge_scorer
import numpy as np

# 1. Load pretrained model
summarizer = pipeline(
    "summarization",
    model="sshleifer/distilbart-cnn-12-6"
)

# 2. Load 20 news articles
data = load_dataset(
    "cnn_dailymail", "3.0.0", split="test[:20]"
)

# 3. Generate summaries and evaluate
scorer = rouge_scorer.RougeScorer(
    ["rouge1", "rouge2", "rougeL"],
    use_stemmer=True
)

scores = []

for i, d in enumerate(data):
    article = d["article"]
    reference = d["highlights"]

    summary = summarizer(
        article,
        max_length=60,
        min_length=15,
        do_sample=False,
        truncation=True
    )[0]["summary_text"]

    result = scorer.score(reference, summary)
    scores.append(result)

    print(f"\nArticle {i+1}")
    print("Summary:", summary)
    print("Reference:", reference)

# 4. Calculate average ROUGE scores
for metric in ["rouge1", "rouge2", "rougeL"]:
    avg = np.mean([s[metric].fmeasure for s in scores])
    print(f"\n{metric.upper()} F1 Score: {avg:.4f}")
print("Final Evaluation on 20 Articles")

for metric in ["rouge1", "rouge2", "rougeL"]:
    precision = np.mean([s[metric].precision for s in scores])
    recall = np.mean([s[metric].recall for s in scores])
    f1 = np.mean([s[metric].fmeasure for s in scores])

    print(f"\n{metric.upper()}")
    print(f"Precision: {precision:.4f}")
    print(f"Recall:    {recall:.4f}")
    print(f"F1 Score:  {f1:.4f}")

